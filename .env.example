# ============================================================================
# Hubricon: every key and setting the project reads, in one place.
#
# Copy this file to .env in the same folder (/home/lp9/Hubricon/HubriconB2B/.env).
# .env is git-ignored. Both worktrees (main and HubriconB2B-content) read that
# one file. Never commit .env, and never paste a key into a chat.
#
# Each entry says where to get it, what it switches on, and where it ends up:
#   [this PC]   stays in .env on this computer
#   [→ GitHub]  Claude copies it into GitHub Actions (the Production environment)
#   [→ Vercel]  Claude copies it into the Vercel project
# Fill sections 1 and 2, check 4, and tell Claude "keys are in". Claude tests
# each one with a harmless read (nothing is charged), copies the cloud ones
# over, runs the setup scripts and reports one line per key.
# ============================================================================

# ── 0. One-time steps that are not keys ─────────────────────────────────────
#
# 1. YouTube upload (the films go out by the YouTube Data API):
#    console.cloud.google.com → new project → APIs & Services → enable
#    "YouTube Data API v3" → OAuth consent screen (External, your account as a
#    test user) → Credentials → Create OAuth client ID → type "Desktop app" →
#    download the JSON and save it as
#      /home/lp9/Hubricon/HubriconB2B-content/content/.secrets/client_secret.json
#    Then run once:  cd /home/lp9/Hubricon/HubriconB2B-content/content &&
#      .venv/bin/hubricon-content youtube-auth   (a browser sign-in to the channel)
#    Then request Google's free "YouTube API Services audit" for the project.
#    Until it passes, Google forces every video uploaded by the API to private.
#
# 2. Your voice (the narration of every film):
#    Follow docs/content/VOICE-RECORDING.md (content worktree): at least 30
#    minutes of calm reading over two or three sittings, one quiet room, the
#    same microphone, WAV 48 kHz 24-bit mono, no processing. Then in
#    elevenlabs.io → Voices → Add voice → Professional Voice Clone, upload the
#    takes and complete ElevenLabs' own check that the voice is yours. Paste
#    the new voice's ID into ELEVENLABS_VOICE_ID below.
#
# 3. GitHub, once, in a terminal:  gh auth refresh -h github.com -s workflow
#    (lets Claude push the two held edits to .github/workflows).
#
# 4. Optional:  sudo pacman -S tesseract tesseract-data-eng
#    (lets the film pipeline reject footage with text burned into it by
#    machine; without it the visual pick checks by eye).
#
# Higgsfield (the AI texture images) needs no key here: it runs through the
# claude.ai connector you already authorised.

# ── 1. The video pipeline (new) ─────────────────────────────────────────────

# pexels.com/api → "Your API key". Stock footage. 200 requests an hour.  [this PC]
PEXELS_API_KEY=
# pixabay.com/api/docs → your key is shown at the top once signed in. Stock
# footage. 100 requests a minute.  [this PC]
PIXABAY_API_KEY=
# api.data.gov/signup → the key is emailed. Smithsonian Open Access, the CC0
# archival photographs.  [this PC]
SMITHSONIAN_API_KEY=
# Any address you read. Sent in the polite User-Agent the Library of Congress,
# Wikimedia Commons and SEC EDGAR ask automated readers for (EDGAR requires
# one). No account.  [this PC]
CONTENT_CONTACT_EMAIL=
# Where the "ready for your review" emails go (scripts, final cuts).  [this PC]
CONTENT_REVIEW_EMAIL=
# elevenlabs.io → profile → API keys. Already set. The plan must allow a
# Professional Voice Clone, and one 40-minute film a day is about one million
# characters a month.  [this PC, → GitHub]
ELEVENLABS_API_KEY=
# The Professional Voice Clone's ID, after step 0.2 (ElevenLabs → Voices →
# your voice → ID).  [this PC, → GitHub]
ELEVENLABS_VOICE_ID=
# Optional tuning; these defaults are what the pipeline uses when unset.
# ELEVENLABS_MODEL=eleven_multilingual_v2
# ELEVENLABS_STABILITY=0.45
# ELEVENLABS_SIMILARITY=0.85
# ELEVENLABS_STYLE=0.08
# Speech-to-text for aligning narration to the picture. The GPU needs CUDA
# libraries this PC lacks today (libcublas); Claude adds them to the pipeline
# and switches the default to cuda, so leave these unset.
# CONTENT_WHISPER_MODEL=small
# CONTENT_WHISPER_DEVICE=cpu
# Lets the offline placeholder voice render a test cut. It never ships.
# CONTENT_ALLOW_PLACEHOLDER=1
# A Chrome for the film stage; else Playwright's own.
# CHROME_BIN=

# ── 2. Production money and access ──────────────────────────────────────────

# dashboard.stripe.com → Developers → API keys → Create restricted key, with
# write access to Customers, Products, Prices, Subscriptions, Invoices, Credit
# notes, Refunds and Webhook endpoints. Billing, refunds and the exit true-up.
# Claude then runs `npm run stripe:setup`, which creates the price and the
# webhook and prints STRIPE_PRICE_ID and STRIPE_WEBHOOK_SECRET; Claude sets
# those too.  [this PC, → GitHub, → Vercel]
STRIPE_SECRET_KEY=
# STRIPE_PRICE_ID=          (printed by stripe:setup; Claude sets it)  [→ GitHub]
# STRIPE_WEBHOOK_SECRET=    (printed by stripe:setup; Claude sets it)  [→ Vercel]

# vercel.com → Account Settings → Tokens → Create, scoped to the Hubricon
# team. Lets Claude read and set the website's environment variables.  [this PC]
VERCEL_TOKEN=
# supabase.com/dashboard/account/tokens → Generate new token. Lets Claude
# install the sign-in email template, send sign-in emails through Resend, and
# apply database changes.  [this PC]
SUPABASE_ACCESS_TOKEN=
# github.com/settings/personal-access-tokens → Fine-grained token → only
# anderlecht-debug/HubriconB2B → Actions: Read and write. An upload wakes the
# operator straight away instead of hours later.  [→ Vercel]
GITHUB_DISPATCH_TOKEN=
GITHUB_DISPATCH_REPO=anderlecht-debug/HubriconB2B
# GITHUB_DISPATCH_REF=main
# calendly.com/integrations/api_webhooks → Personal access token. Bookings
# arrive in seconds instead of the inbox routine reading emails every two
# hours. Webhooks need a paid Calendly plan (Standard or above).  [this PC]
CALENDLY_TOKEN=
# Salts the hashed IP in tool_runs; Claude generates one.  [→ Vercel]
# RATE_LIMIT_SALT=

# ── 3. Already set (leave as they are) ──────────────────────────────────────

SUPABASE_URL=https://cgqvdnhgbfxikzdqqaws.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=
# The workspace id shown beside the key in console.anthropic.com
ANTHROPIC_WORKSPACE_ID=
RESEND_API_KEY=
# A real mailing address (a PO box is fine). CAN-SPAM wants one in every
# marketing email.  [this PC, → GitHub, → Vercel]
POSTAL_ADDRESS=

# ── 4. Addresses and links (no account; check the defaults) ─────────────────

# Sender and reply-to on every client email.  [this PC, → GitHub, → Vercel]
EMAIL_FROM=Hagen Simmons <hagen.simmons@hubricon.com>
EMAIL_REPLY_TO=hagen.simmons@hubricon.com
# Sender of the founder's alert emails, and where the daily digest goes.  [→ GitHub]
ALERT_FROM=Hubricon <hagen.simmons@hubricon.com>
FOUNDER_EMAIL=
# The address the client's seat invites go to.  [this PC]
EXECUTION_EMAIL=hagen.simmons@hubricon.com
# The booking page every "book your call" email links to.  [this PC]
CALENDLY_URL=https://calendly.com/hubricon/margin-audit
# Where the portal and upload pages live.  [this PC, → Vercel]
INTAKE_BASE_URL=https://www.hubricon.com
# Where replies send a prospect who is not ready for a call (defaults to the
# Fee Staircase course; Shopify prospects go to The Price Curve).
# LEARN_URL=https://www.hubricon.com/learn/fee-staircase
# TEARDOWN_CTA_URL=     (the retired cold teardown page's button; unused)

# ── 5. Only if cold outreach restarts (paused by the spec) ──────────────────

# app.instantly.ai → Settings → Integrations → API key. The cold campaign,
# reply sync and lead lists.  [→ GitHub; this PC only to push lists by hand]
INSTANTLY_API_KEY=
# INSTANTLY_LIST_MATCH=
# SUPERSEARCH_DAILY=
# Nothing sends while this is on. Leave it on.
COLD_DRY_RUN=true
# COLD_MIN_CONFIDENCE=0.70     raising it sends less and is always safe
# COLD_MIN_MONTHLY_USD=250     below this a finding is true and not worth reading
# COLD_MAX_CLAIM_SHARE=0.25    a claim worth more than this share of the listing's
#                              own estimated revenue is the volume curve misbehaving
# COLD_DAILY_BUDGET_USD=25     refuses to start a batch that would exceed it
# COLD_DOMAIN_DAILY_CAP=40     per sending domain per day, enforced in code
# COLD_PER_MAILBOX_DAILY=
# COLD_TEARDOWN_TTL_DAYS=45    how long /t/<token> stays live
# COLD_TEARDOWN_BASE_URL=https://hubricon.com/t
# COLD_RECONTACT_DAYS=90       floor between touches on one prospect
# COLD_MAX_TOUCHES=3           lifetime cap per prospect
# COLD_SUPPRESSED_JURISDICTIONS=GB,IE,DE,...   default: the EU, the UK, EEA and CH

# Shopify lead sourcing (`hubricon source`), run on this PC. Nothing here sends
# an email: leads land in a Google Sheet and in an Instantly list the
# operator's enrolment cannot match. `hubricon source install` adds a systemd
# timer. See OPERATIONS.md, "Sourcing".
# The Google Sheet: paste scripts/sheet-sync.gs into the sheet (Extensions ->
# Apps Script -> Deploy as web app, "Execute as: me", "Who has access: anyone
# with the link"); SECRET in that script and SOURCING_SHEET_SECRET must match.
# Unset, the pass still writes ~/.hubricon/sourcing/leads.csv and says so.
SOURCING_SHEET_URL=
SOURCING_SHEET_SECRET=
# The qualification bar. Calibrate it before trusting it: label a hundred
# stores by hand, then `hubricon source calibrate --file labels.csv`; 55 is a
# starting guess, not a measurement.
SOURCING_MIN_SCORE=55
# The slice of the Tranco top-1M to walk (the head is waste and the tail mostly
# non-US), the DNS fan-out, the /products.json pages per store, and per-pass caps.
SOURCING_RANK_FROM=20000
SOURCING_RANK_TO=600000
SOURCING_TRANCO_LIMIT=1000000
SOURCING_DNS_WORKERS=32
SOURCING_CATALOG_PAGES=4
SOURCING_DISCOVER_LIMIT=2000
SOURCING_QUALIFY_LIMIT=200
SOURCING_CONTACT_LIMIT=60
SOURCING_PROMOTE_LIMIT=40
# The free lead harvest: its Amazon steps are off (Amazon refuses automated
# reads), so only the Shopify knobs matter; every one has a working default.
# HARVEST_SHOPIFY_ORDERS_PER_REVIEW=50   a guess, not a calibration
# HARVEST_SHOPIFY_MIN_ANNUAL=500000
# HARVEST_SHOPIFY_MAX_ANNUAL=40000000
# HARVEST_SHOPIFY_SEARCH_TERMS=6
# HARVEST_SHOPIFY_CDX_PAGES=40
# HARVEST_SHOPIFY_SAMPLE=3
# HARVEST_SHOPIFY_LIMIT=120
# HARVEST_RUN_ALL_SHOPIFY=60
# HARVEST_CHROME=        a Chrome binary; else a system Chrome/Chromium or Playwright's

# ── 6. Optional tuning (the defaults work) ──────────────────────────────────

# The Brief's spoken walkthrough: elevenlabs (default when the key is set),
# local (espeak-ng), or off.
# HUBRICON_TTS=
# Claude-narrated letters and reply triage; the models default to the current ones.
# HUBRICON_NARRATOR=on
# HUBRICON_NARRATOR_MODEL=
# HUBRICON_TRIAGE=on
# HUBRICON_TRIAGE_MODEL=
# A Shopify store's card rate when it is not the published 2.9% + 30¢ (the
# Payouts export overrides both whenever it is on file).
# SHOPIFY_PAYMENTS_RATE=0.029
# SHOPIFY_PAYMENTS_FIXED=0.30
# The recovery-only plan (the downsell; terms §4): a share of the
# reimbursements Amazon actually paid on claims we filed, invoiced at month
# end; amounts under the minimum roll into the next month.
RECOVERY_SHARE=0.25
RECOVERY_MIN_INVOICE_USD=50
