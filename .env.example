# Vercel project env vars (Settings → Environment Variables on hubricon-b2-b)
STRIPE_SECRET_KEY=sk_live_or_restricted_key
STRIPE_WEBHOOK_SECRET=whsec_printed_by_stripe_setup
SUPABASE_URL=https://cgqvdnhgbfxikzdqqaws.supabase.co
SUPABASE_SERVICE_ROLE_KEY=service_role_key_from_supabase_dashboard

# Engine only (never needed on Vercel): enables the Claude-narrated Issue letter in `hubricon script`
ANTHROPIC_API_KEY=sk-ant-your-key
# Required with identity-linked keys: the workspace id shown beside the key in the Console
ANTHROPIC_WORKSPACE_ID=wrkspc_your-workspace-id
# HUBRICON_NARRATOR_MODEL=claude-fable-5-1   # optional override

# Local alert emails from `hubricon sweep --alert` (the GitHub sweep has these as secrets)
# and branded onboarding emails from `npm run new-client -- --send welcome`.
# The key must come from the Resend team that owns hubricon.com.
# RESEND_API_KEY=re_your-key
# ALERT_FROM=Hubricon <hagen.simmons@hubricon.com>
# FOUNDER_EMAIL=you@example.com
# EMAIL_FROM=Hagen Simmons <hagen.simmons@hubricon.com>   # onboarding sender (default shown)

# Shopify harvest (the founder's Mac only; every knob has a working default).
# ORDERS_PER_REVIEW is a guess, not a calibration — the whole size band rides
# on it, so check ten stores of known size before trusting what it pushes.
# HARVEST_SHOPIFY_ORDERS_PER_REVIEW=50
# HARVEST_SHOPIFY_MIN_ANNUAL=500000
# HARVEST_SHOPIFY_MAX_ANNUAL=40000000
# HARVEST_SHOPIFY_SEARCH_TERMS=6    # product categories searched per run (--source search, the default)
# HARVEST_SHOPIFY_CDX_PAGES=40      # index pages sampled, for the weaker --source archive
# HARVEST_SHOPIFY_SAMPLE=3          # product pages read per store, for the review count
# HARVEST_SHOPIFY_LIMIT=120         # stores per `hubricon harvest shopify`
# HARVEST_RUN_ALL_SHOPIFY=60        # stores per scheduled `harvest all`

# Shopify client data: the store's card rate, when it is not the published one.
# The payouts export overrides both whenever it is on file.
# SHOPIFY_PAYMENTS_RATE=0.029
# SHOPIFY_PAYMENTS_FIXED=0.30

# The cold engine (`hubricon teardown`). POSTAL_ADDRESS is the only required one:
# CAN-SPAM wants a physical address in every cold message and the engine refuses
# to draft without it. It is already a GitHub environment secret for the
# operator; the Mac needs its own copy.
# POSTAL_ADDRESS=Hubricon, PO Box 000, Austin TX 78701
# COLD_DRY_RUN=true            # nothing sends while this is on. Leave it on.
# COLD_MIN_CONFIDENCE=0.70     # raising it sends less and is always safe
# COLD_MIN_MONTHLY_USD=250     # below this a finding is true and not worth reading
# COLD_MAX_CLAIM_SHARE=0.25    # a claim worth more than this share of the listing's
#                              # own estimated revenue is the volume curve misbehaving
# COLD_DAILY_BUDGET_USD=25     # refuses to start a batch that would exceed it
# COLD_DOMAIN_DAILY_CAP=40     # per sending domain per day, enforced in code
# COLD_TEARDOWN_TTL_DAYS=45    # how long /t/<token> stays live
# COLD_TEARDOWN_BASE_URL=https://hubricon.com/t
# COLD_RECONTACT_DAYS=90       # floor between touches on one prospect
# COLD_MAX_TOUCHES=3           # lifetime cap per prospect
# COLD_SUPPRESSED_JURISDICTIONS=GB,IE,DE,...   # default: the EU, the UK, EEA and CH

# ── Keeping the promises the site makes ─────────────────────────────────────
# Each of these backs a specific line of client-facing copy. Without one, the
# promise fails quietly — `hubricon promises` says which, and the daily digest
# repeats it.

# The recorded walkthrough promised on index.html, welcome.html and terms.html §2.
# Without a voice the issue still publishes its letter and report; only the
# video is missing, and the digest says so.
#   HUBRICON_TTS=elevenlabs  (default when the key is set)
#   HUBRICON_TTS=local       macOS `say` / espeak-ng — no vendor, flatter voice
#   HUBRICON_TTS=off         no audio at all
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
HUBRICON_TTS=

# The day-30 guarantee (terms.html §3). The operator's billing pass is the only
# code that starts billing, and it needs the price to bill against. Without it a
# client who clears the bar is flagged in the digest instead — nobody is ever
# wrongly billed, they are just not billed at all.
#   Get it from: npm run stripe:setup  (prints the price id)
STRIPE_PRICE_ID=

# welcome.html: "reply to any Hubricon email and it lands with the person who
# builds your models." Every client email is sent from EMAIL_FROM with this as
# the reply-to.
EMAIL_FROM=
EMAIL_REPLY_TO=

# Where the client's desk and upload pages live; used in every client email.
INTAKE_BASE_URL=
EXECUTION_EMAIL=
